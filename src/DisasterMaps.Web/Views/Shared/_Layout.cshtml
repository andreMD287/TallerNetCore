<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] · DisasterMaps</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/disastermaps.css" asp-append-version="true" />
  @await RenderSectionAsync("Styles", required: false)
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
    <div class="container-fluid px-lg-5">
      <a class="navbar-brand fw-bold" href="/">🌎 DisasterMaps</a>
      <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
      <div class="collapse navbar-collapse" id="nav">
        <div class="navbar-nav ms-auto gap-lg-2">
          <a class="nav-link" href="/">Mapa</a>
          <a class="nav-link" href="/Impacts">Afectaciones</a>
          <a class="nav-link" href="/Impacts/Create">Registrar</a>
          <a class="nav-link" href="/Import">Importar</a>
          <a class="nav-link" href="/Events">Eventos</a>
          <a class="nav-link" href="/Stats">Resumen</a>
        </div>
      </div>
    </div>
  </nav>
  <main class="container-fluid px-lg-5 py-4">
    @if (ViewBag.Warning != null) { <div class="alert alert-warning">@ViewBag.Warning</div> }
    @if (TempData["Warning"] != null) { <div class="alert alert-warning">@TempData["Warning"]</div> }
    @RenderBody()
  </main>
  <footer class="text-center text-muted small pb-3">Proyecto académico · Arquitectura 3-Tier distribuida · Datos de ejemplo no oficiales</footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
