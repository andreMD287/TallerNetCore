@model System.Text.Json.Nodes.JsonArray
@{ ViewData["Title"] = "Eventos"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Eventos de desastre</h1><p class="lead-small">Registro de eventos y sus afectaciones asociadas.</p></div><a class="btn btn-primary" href="/Events/Create">+ Nuevo evento</a></div>
<div class="panel table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Nombre</th><th>Tipo</th><th>Inicio UTC</th><th>Descripción</th></tr></thead><tbody>
@foreach(var e in Model){<tr><td>@(e?["name"]?.ToString())</td><td><span class="badge bg-primary">@(e?["type"]?.ToString())</span></td><td>@(e?["startedAt"]?.ToString())</td><td>@(e?["description"]?.ToString())</td></tr>}
</tbody></table></div>
