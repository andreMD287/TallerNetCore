{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataTier": {
    "UseFake": false,
    "Address": "http://localhost:5003",
    "DeadlineSeconds": 3,
    "BatchDeadlineSeconds": 60
  },
  "Sync": {
    "MaxItems": 10000
  },
  "Severity": {
    "Medium": 1,
    "High": 50,
    "Critical": 500
  },
  "OpenApi": {
    "Enabled": false
  }
}
